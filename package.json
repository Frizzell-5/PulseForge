{
  "name": "pulseforge-studio",
  "version": "0.1.0",
  "description": "PulseForge Studio: free, open-source music studio for browser, desktop and mobile.",
  "main": "desktop/main.js",
  "license": "MIT",
  "scripts": {
    "start": "npx --yes serve -l 3000 .",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.pulseforge.studio",
    "productName": "PulseForge Studio",
    "files": [
      "index.html",
      "app.html",
      "sw.js",
      "manifest.webmanifest",
      "css/**",
      "js/**",
      "icons/**",
      "desktop/**"
    ],
    "icon": "icons/icon-512.png",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "PulseForge-Studio-macOS.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PulseForge-Studio-Windows-Setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "artifactName": "PulseForge-Studio-Linux.${ext}",
      "maintainer": "PulseForge Studio contributors"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "author": "PulseForge Studio contributors",
  "homepage": "https://github.com/Frizzell-5/PulseForge"
}
